# production サーバー用の .env テンプレート。コピーして値を埋め、そのサーバーに
# `.env` として置く（コミットしない）。docker-compose.prod.yml と一緒に使う。
#
#   cp .env.production.example .env
#
# staging サーバーには .env.staging.example の方を使う。ドメイン・シークレット
# 以外はほぼ同じ内容だが、テンプレートを分けているのは値を混同しないため
# （特にMYSQL_*・JWT_SECRETをstagingと使い回さないこと）。

TZ=Asia/Tokyo

# --- Database ---
MYSQL_DATABASE=tracking_parking
MYSQL_ROOT_PASSWORD=<openssl rand -hex 32 で生成した値>
MYSQL_USER=trapa
MYSQL_PASSWORD=<openssl rand -hex 32 で生成した値>
DATABASE_URL=mysql+pymysql://trapa:<上のMYSQL_PASSWORDと同じ値>@db:3306/tracking_parking

# --- API ---
API_PORT=8000
DEVICE_OFFLINE_THRESHOLD_SECONDS=120
# ブラウザからのアクセスを許可するオリジン（カンマ区切り）。
CORS_ORIGINS=https://app.trapa.nutfes.net,https://manager.trapa.nutfes.net,https://admin.trapa.nutfes.net

# Google Cloud Console で作成したOAuthクライアントID。ローカル開発（.env.develop）・
# staging・production共通の1つのクライアントを使う。承認済みJavaScript生成元に、
# 既存のhttp://localhost:5174/5175に加えて以下4つを全て追加する:
#   https://manager.trapa.nutfes.net, https://admin.trapa.nutfes.net,
#   https://stg.manager.trapa.nutfes.net, https://stg.admin.trapa.nutfes.net
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Admin認証 ---
JWT_SECRET=<openssl rand -hex 32 で生成した値。stagingとは別の値にする>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Cloudflare Tunnel経由で常にHTTPSになるので true 固定
COOKIE_SECURE=true

# --- フロントエンド（ビルド時にVite側へ埋め込まれる） ---
WEB_PORT=5173
MANAGER_PORT=5175
ADMIN_WEB_PORT=5174
VITE_API_BASE_URL=https://api.trapa.nutfes.net

# --- Cloudflare Tunnel ---
# Cloudflare Zero Trust ダッシュボードでこのproduction用に作成したトンネルの
# トークン（Docker向けのインストールコマンドに含まれる --token の値）。
# 公開ホスト名ごとのingress設定（app/manager/admin/api →
# http://<service>:<port>）もダッシュボード側で行う。
# 詳細はREADMEの「デプロイ（ステージング／本番）」を参照。
CLOUDFLARE_TUNNEL_TOKEN=<Cloudflare Zero Trustで発行したトンネルトークン>
