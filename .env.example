TZ=Asia/Tokyo

# --- Database ---
MYSQL_DATABASE=tracking_parking
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=trapa
MYSQL_PASSWORD=trapa_password
DB_HOST=db
DB_PORT=3306

DATABASE_URL=mysql+pymysql://trapa:trapa_password@db:3306/tracking_parking

# --- API ---
API_PORT=8000
# Seconds since last heartbeat before a device is considered offline
DEVICE_OFFLINE_THRESHOLD_SECONDS=120
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Google Sign-In（Admin/manager共通のOAuthクライアントID。秘密情報ではないが
# --- 未設定のプレースホルダーのままだとトークン検証が全て失敗する） ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# フロントエンド（manager・admin-web）用。値はGOOGLE_CLIENT_IDと同じにする。
# web（公開ビューア）はログイン機能自体を持たないため不要
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Admin認証 ---
# 必ず本番環境では固有のランダムな値に変更すること: openssl rand -hex 32
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# HttpOnly Cookie の Secure 属性。HTTPS配下でのみ true にできる
COOKIE_SECURE=false

# --- Web (公開ビューア: 空き状況の閲覧のみ、ログイン不要) ---
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- Manager (駐車場管理者コンソール: サインインした人だけ台数を手動増減) ---
MANAGER_PORT=5175

# --- Admin Web (管理コンソール: 駐車場・デバイスの登録・削除・リセットなどの操作) ---
ADMIN_WEB_PORT=5174
